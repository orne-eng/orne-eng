{
  "datasets": [
    {
      "name": "7acb57bd",
      "displayName": "Global Carbon Emissions by Location Dataset 2023",
      "queryLines": [
        "SELECT \r\n",
        "  latitude, \r\n",
        "  longitude, \r\n",
        "  `GHG emissions mtons CO2e` AS Emissions\r\n",
        "FROM emissions.default.emissions_data_2023\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "eb7d8f07",
      "displayName": "County Wise Per Capita Emissions Ranking Dataset",
      "queryLines": [
        "SELECT county_state_name,\r\n",
        "  population,\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / NULLIF(CAST(population AS DOUBLE), 0) AS Emissions_per_person\r\n",
        "FROM emissions_data_2023\r\n",
        "ORDER BY Emissions_per_person DESC\r\n"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "7ad6acf2",
      "displayName": "Top Fifteeen States by Greenhouse Gas Emissions Summary",
      "queryLines": [
        "WITH top15 AS (\n",
        "SELECT state_abbr,\r\n",
        " SUM (CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') \r\n",
        " AS DOUBLE\r\n",
        " )) AS Total_emissions\r\n",
        "FROM emissions_data_2023\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_emissions DESC\r\n",
        "LIMIT 15\n",
        ")\n",
        "SELECT state_abbr,\n",
        "  Total_emissions,\n",
        "  Total_emissions / SUM(Total_emissions) OVER () AS pct_of_total\n",
        "FROM top15\n",
        "ORDER BY Total_emissions DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "939c4355",
      "displayName": "Top Fifteen States Contribution To Total Emissions Percent",
      "queryLines": [
        "WITH state_totals AS (\r\n",
        "  SELECT\r\n",
        "    state_abbr,\r\n",
        "    SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS state_emissions\r\n",
        "  FROM emissions.default.emissions_data_2023\r\n",
        "  GROUP BY state_abbr\r\n",
        "),\r\n",
        "top_15 AS (\r\n",
        "  SELECT state_abbr, state_emissions\r\n",
        "  FROM state_totals\r\n",
        "  ORDER BY state_emissions DESC\r\n",
        "  LIMIT 15\r\n",
        "),\n",
        "pct AS (\n",
        "  SELECT 100.0 * SUM(t.state_emissions) / (SELECT SUM(state_emissions) FROM state_totals) AS top_15_pct\n",
        "  FROM top_15 t\n",
        ")\n",
        "SELECT 'Top 15 states' AS segment,\n",
        "  top_15_pct / 100.0 AS share\n",
        "FROM pct\n",
        "UNION ALL\n",
        "SELECT 'Other states' AS segment,\n",
        "  1.0 - top_15_pct / 100.0 AS share\n",
        "FROM pct"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "8fbe5c3f",
      "displayName": "Employment and Vehicle Travel by State Summary",
      "queryLines": [
        "WITH state_totals AS (\r\n",
        "  SELECT\r\n",
        "    state_abbr,\r\n",
        "    SUM(employment) AS employment,\r\n",
        "    SUM(population) AS population,\r\n",
        "    SUM(CAST(REPLACE(`vehicle miles traveled (miles)`, ',', '') AS DOUBLE)) AS vehicle_miles_traveled,\r\n",
        "    SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS total_emissions\r\n",
        "  FROM emissions.default.emissions_data_2023\r\n",
        "  GROUP BY state_abbr\r\n",
        ")\r\n",
        "SELECT\r\n",
        "  state_abbr,\r\n",
        "  employment,\r\n",
        "  vehicle_miles_traveled,\r\n",
        "  total_emissions,\r\n",
        "  total_emissions / NULLIF(CAST(employment AS DOUBLE), 0) AS emissions_per_job,  vehicle_miles_traveled / NULLIF(CAST(population AS DOUBLE), 0) AS vehicle_miles_per_person,\n",
        "  ROW_NUMBER() OVER (ORDER BY total_emissions DESC) AS emissions_rank\n",
        "FROM state_totals\r\n",
        "ORDER BY state_abbr"
      ],
      "catalog": "emissions",
      "schema": "default"
    }
  ],
